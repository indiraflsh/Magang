rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc (for getFromServer verification)
    match /test/connection {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);
    }

    // Attendance logs
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(attendanceId);
      allow update, delete: if isSignedIn() && isValidId(attendanceId);
    }

    // Daily journals & reports
    match /journals/{journalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(journalId);
      allow update, delete: if isSignedIn() && isValidId(journalId);
    }

    // Student progress summaries
    match /progress/{progressId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(progressId);
      allow delete: if isSignedIn() && isValidId(progressId);
    }
  }
}
